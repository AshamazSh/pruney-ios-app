          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à 50 suppressions et 10 redimensionnements ou conversions en images fixes par session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回につき削除50件、リサイズまたは静止画化10件まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 삭제 50개, 크기 조절 또는 정지 사진 변환 10개까지."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次最多删除50个项目，调整大小或转为静态10个项目。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a 50 eliminazioni e 10 ridimensionamenti o conversioni statiche per sessione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За один раз — до 50 удалений и 10 уменьшений или преобразований в статичные."
          }
        }
      }
    },
