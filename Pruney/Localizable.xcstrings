    "Replacements remove the originals. Live Photos keep their original still image without resizing or motion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements remove the originals. Live Photos keep their original still image without resizing or motion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los reemplazos eliminan los originales. Las Live Photos conservan su imagen original sin redimensionar ni movimiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As substituições removem os originais. As Live Photos mantêm a imagem original sem redimensionar ou movimento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersatzdateien ersetzen die Originale. Live Photos behalten ihr Originalbild ohne Verkleinerung oder Bewegung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les remplacements suppriment les originaux. Les Live Photos conservent leur image originale sans redimensionnement ni mouvement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置き換えにより元の項目は削除されます。Live Photosはリサイズせず、元の静止画を残して動きのみ削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체 작업은 원본을 삭제합니다. Live Photos는 크기 조절이나 움직임 없이 원본 사진을 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换会移除原始文件。实况照片保留原始静态图像，不调整大小并移除动态效果。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sostituzioni rimuovono gli originali. Le Live Photos mantengono l’immagine originale senza ridimensionamento né movimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При замене оригиналы удаляются. Live Photos сохраняют исходный кадр без изменения размера и движения."
          }
        }
      }
    },
