    "Deleting first, then preparing replacements. Some changes may already be applied.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting first, then preparing replacements. Some changes may already be applied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se eliminan los elementos y después se preparan los reemplazos. Algunos cambios pueden haberse aplicado ya."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro excluímos, depois preparamos as substituições. Algumas alterações já podem ter sido aplicadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst wird gelöscht, danach werden Ersatzdateien vorbereitet. Einige Änderungen können bereits erfolgt sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suppression d’abord, puis préparation des remplacements. Certaines modifications peuvent déjà être appliquées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に削除し、その後に置き換え用ファイルを準備します。一部の変更は適用済みの可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 삭제한 뒤 대체 파일을 준비합니다. 일부 변경은 이미 적용되었을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先删除，再准备替换文件。部分更改可能已经执行。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima l’eliminazione, poi la preparazione dei file sostitutivi. Alcune modifiche potrebbero essere già applicate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала удаляем, затем готовим замену. Часть изменений уже могла быть применена."
          }
        }
      }
    },
