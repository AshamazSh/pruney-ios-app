    "Clear your choices and start again from the beginning? Your photos and videos won’t be changed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear your choices and start again from the beginning? Your photos and videos won’t be changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar tus selecciones y empezar desde el principio? Tus fotos y vídeos no cambiarán."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar suas escolhas e recomeçar? Suas fotos e vídeos não serão alterados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswahl zurücksetzen und von vorn beginnen? Deine Fotos und Videos bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer vos choix et recommencer ? Vos photos et vidéos ne seront pas modifiées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択をリセットして最初からやり直しますか？写真や動画は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택을 초기화하고 처음부터 시작할까요? 사진과 동영상은 변경되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除选择并重新开始？照片和视频不会更改。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellare le scelte e ricominciare? Le foto e i video non saranno modificati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбросить выбор и начать сначала? Фото и видео не будут изменены."
          }
        }
