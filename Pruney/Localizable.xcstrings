          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu fototeca aún no tiene fotos ni vídeos. Pruney actualizará los totales cuando añadas contenido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
