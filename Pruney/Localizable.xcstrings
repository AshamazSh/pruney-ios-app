    "Your purchase is pending approval. Your current item has not been selected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is pending approval. Your current item has not been selected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. El elemento actual no se ha seleccionado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra aguarda aprovação. O item atual não foi selecionado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Das aktuelle Objekt wurde nicht ausgewählt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est en attente d’approbation. L’élément actuel n’a pas été sélectionné."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。現在の項目は選択されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 승인 대기 중입니다. 현재 항목은 선택되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买正在等待批准。当前项目未被选择。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto è in attesa di approvazione. L’elemento attuale non è stato selezionato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает подтверждения. Текущий элемент не выбран."
          }
        }
      }
    },
    "Your selection exceeds the free per-run limit. Return to review and reduce your choices or unlock Pruney Pro. No actions were applied.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selection exceeds the free per-run limit. Return to review and reduce your choices or unlock Pruney Pro. No actions were applied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu selección supera el límite gratuito por sesión. Vuelve y reduce tus selecciones o desbloquea Pruney Pro. No se aplicaron acciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua seleção excede o limite gratuito por sessão. Volte e reduza as escolhas ou desbloqueie o Pruney Pro. Nenhuma ação foi aplicada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auswahl überschreitet das kostenlose Limit pro Durchgang. Reduziere die Auswahl oder schalte Pruney Pro frei. Keine Aktionen wurden ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre sélection dépasse la limite gratuite par session. Réduisez vos choix ou débloquez Pruney Pro. Aucune action n’a été appliquée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択が1回の無料枠を超えています。戻って選択を減らすか、Pruney Proを購入してください。操作は適用されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목이 무료 작업 한도를 초과합니다. 돌아가 선택을 줄이거나 Pruney Pro를 구매하세요. 작업은 적용되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选项目超出单次免费额度。请返回减少选择或解锁Pruney Pro。未执行任何操作。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La selezione supera il limite gratuito per sessione. Riduci le scelte o sblocca Pruney Pro. Nessuna azione è stata applicata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор превышает бесплатный лимит за один раз. Вернитесь и сократите выбор или купите Pruney Pro. Действия не применены."
          }
        }
      }
    },
