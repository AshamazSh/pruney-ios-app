    "Couldn’t fully measure %lld items. They may be stored in iCloud. The total size is incomplete.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Couldn’t fully measure %lld item. It may be stored in iCloud. The total size is incomplete."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Couldn’t fully measure %lld items. They may be stored in iCloud. The total size is incomplete."
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo medir por completo esta cantidad de elementos: %lld. Puede que estén en iCloud. El tamaño total está incompleto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível medir completamente estes itens: %lld. Eles podem estar no iCloud. O tamanho total está incompleto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht vollständig gemessene Objekte: %lld. Sie könnten in iCloud liegen. Die Gesamtgröße ist unvollständig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éléments non entièrement mesurés : %lld. Ils peuvent être dans iCloud. La taille totale est incomplète."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に測定できなかった項目：%lld。iCloudに保存されている可能性があります。合計サイズは不完全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 크기를 측정하지 못한 항목: %lld. iCloud에 있을 수 있습니다. 합계 크기가 불완전합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完整测量的项目：%lld。可能存储在iCloud中。总大小不完整。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementi non misurati completamente: %lld. Potrebbero essere in iCloud. La dimensione totale è incompleta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось полностью измерить элементов: %lld. Возможно, они в iCloud. Общий размер неполный."
          }
        }
      }
    },
