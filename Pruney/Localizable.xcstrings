    "Photo access is restricted by the system. Check your Screen Time restrictions or contact your device administrator.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo access is restricted by the system. Check your Screen Time restrictions or contact your device administrator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema restringe el acceso a Fotos. Revisa Tiempo de uso o contacta con el administrador del dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema restringe o acesso a Fotos. Verifique o Tempo de Uso ou contate o administrador do dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fotozugriff ist vom System eingeschränkt. Prüfe Bildschirmzeit oder kontaktiere die Geräteverwaltung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès aux photos est limité par le système. Vérifiez Temps d’écran ou contactez l’administrateur de l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが写真へのアクセスを制限しています。スクリーンタイムの制限を確認するか、デバイス管理者に連絡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 사진 접근을 제한합니다. 스크린 타임 제한을 확인하거나 기기 관리자에게 문의하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统限制了照片访问。请检查屏幕使用时间限制或联系设备管理员。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso a Foto è limitato dal sistema. Controlla Tempo di utilizzo o contatta l’amministratore del dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к фото ограничен системой. Проверьте ограничения Экранного времени или обратитесь к администратору устройства."
          }
        }
      }
    },
